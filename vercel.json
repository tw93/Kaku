{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/en", "destination": "/", "permanent": true },
    { "source": "/en/", "destination": "/", "permanent": true },
    { "source": "/en/:path*", "destination": "/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/llms.md", "destination": "/index.md" },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "mode", "value": "agent" }],
      "destination": "/agent.json"
    },
    {
      "source": "/zh",
      "has": [{ "type": "query", "key": "mode", "value": "agent" }],
      "destination": "/agent.json"
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "destination": "/index.md"
    },
    {
      "source": "/zh",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "destination": "/zh/index.md"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Link",
          "value": "</sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\", </llms.txt>; rel=\"alternate\"; type=\"text/plain\"; title=\"llms.txt\", </.well-known/agent-skills/index.json>; rel=\"service-desc\"; type=\"application/json\", </schemamap.xml>; rel=\"describedby\"; type=\"application/xml\", </feed.xml>; rel=\"alternate\"; type=\"application/rss+xml\"; title=\"Kaku releases\""
        }
      ]
    },
    {
      "source": "/shots/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/feed.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/feeds/pages.jsonl",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-ndjson; charset=utf-8"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        },
        {
          "key": "Link",
          "value": "</index.md>; rel=\"alternate\"; type=\"text/markdown\", </sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\", </llms.txt>; rel=\"alternate\"; type=\"text/plain\"; title=\"llms.txt\", </llms-full.txt>; rel=\"alternate\"; type=\"text/plain\"; title=\"llms-full.txt\", </.well-known/agent-skills/index.json>; rel=\"service-desc\"; type=\"application/json\", </schemamap.xml>; rel=\"describedby\"; type=\"application/xml\", </agent.json>; rel=\"alternate\"; type=\"application/json\"; title=\"agent view\", </feed.xml>; rel=\"alternate\"; type=\"application/rss+xml\"; title=\"Kaku releases\""
        }
      ]
    }
  ]
}
